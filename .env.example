# Loaded automatically from .env in the directory where you run paper-puller.

# Semantic Scholar API key (recommended): conferences fetch at 1 request/second
# with 1,000 papers per request. Without it, a shared anonymous pool is used.
# Request one at https://www.semanticscholar.org/product/api#api-key
S2_API_KEY=""

# Optional contact email for Crossref (journals). Enables 3 parallel requests.
CROSSREF_MAILTO=""

# Optional: a nonempty key switches TRO to the IEEE Xplore API.
IEEE_API_KEY=""
